  "segments": [
    {
      "block": 0,
      "emotion": "curious",
      "pace": "normal",
      "pause": 1.0,
      "say": [
        "سؤال قبل ما نبلّش: عندك سهمين مرسومين على الأرض، واحد طوله اتنين وواحد طوله تلاتة. بدك سهم تالت واقف عليهم بزاوية قائمة… لفوق ولا لتحت؟ وقديش طوله؟"
      ]
    },
    {
      "block": 0,
      "emotion": "warm",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "بآخر الدرس بتجاوب بثانية. الأداة اسمها",
        {
          "show": "الضرب المتجهي"
        },
        "، وبالعبري بيحكوله",
        {
          "show": "מכפלה וקטורית"
        },
        ". يلا."
      ]
    },
    {
      "block": 4,
      "frame": 1,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "متجهين مش مضاعفات بعض بيفردوا مستوى، متل لوح خشب مسطّح."
      ]
    },
    {
      "block": 4,
      "frame": 2,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.9,
      "say": [
        "هلّق، المسامير اللي بتنغرز بزاوية قائمة بهاللوح… كلها على نفس الخط، بس بأطوال مختلفة. أي مسمار بدنا؟"
      ]
    },
    {
      "block": 4,
      "frame": 3,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "الطول بيجي من المساحة. اللوح مساحته ستة؟ المسمار طوله ستة."
      ]
    },
    {
      "block": 4,
      "frame": 4,
      "emotion": "emphatic",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "وبقي الاتجاه، لفوق ولا لتحت؟ لفّ أصابع إيدك اليمين من الأول للتاني، والإبهام بيشاور على المسمار."
      ]
    },
    {
      "block": 4,
      "frame": 4,
      "emotion": "warm",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "عمودي، مساحة، إيد يمين. هي التلات كلمات اللي بتحدد المتجه الثالث."
      ]
    },
    {
      "block": 5,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "وبالامتحان بيسموها",
        {
          "show": "כלל יד ימין"
        },
        "، فاحفظ الاسم."
      ]
    },
    {
      "block": 9,
      "frame": 1,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "نطّلع على اللوح من فوق. الطولين أربعة وتلاتة، والزاوية تلاتين درجة."
      ]
    },
    {
      "block": 9,
      "frame": 2,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.8,
      "say": [
        "مساحة المتوازي قاعدة ضرب ارتفاع. شو الارتفاع؟ …طول ألفا من فوق، ضرب ساين الزاوية."
      ]
    },
    {
      "block": 9,
      "frame": 3,
      "emotion": "excited",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "أربعة ضرب تلاتة ضرب نص… ستة! وهاي المساحة هي بالضبط طول المسمار."
      ]
    },
    {
      "block": 10,
      "emotion": "serious",
      "pace": "slow",
      "pause": 0.5,
      "say": [
        "التعريف بيجمع التلات: عمودي على الاتنين، طوله بالساين، واتجاهه",
        {
          "show": "جملة يد يمنى"
        },
        ". واللي لازم تتذكره: ساين، مش كوس."
      ]
    },
    {
      "block": 11,
      "emotion": "encouraging",
      "pace": "normal",
      "pause": 0.9,
      "say": [
        "قبل ما تحسب… اسأل حالك: كوس ولا ساين؟"
      ]
    },
    {
      "block": 13,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.6,
      "say": [
        "التعريف حلو بالفكرة، بس مين بدو يقيس زاوية بالامتحان؟ بدنا صيغة من الأرقام بس."
      ]
    },
    {
      "block": 15,
      "frame": 1,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "هاي هي الصيغة. صف فيه الأساس، وتحته متجهينا. اللي لازم تعرفه: كيف بيطلع كل مركّب."
      ]
    },
    {
      "block": 15,
      "frame": 2,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "الأول: غطّي عمود آي، وخد اللي بقي. بي ضرب إف، ناقص سي ضرب إي."
      ]
    },
    {
      "block": 15,
      "frame": 3,
      "emotion": "serious",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "التاني: غطّي عمود جاي… وانتبه! بنبدأ من سي ضرب دي، وبعدين ناقص إيه ضرب إف."
      ]
    },
    {
      "block": 15,
      "frame": 4,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "والتالت: إيه ضرب إي، ناقص بي ضرب دي."
      ]
    },
    {
      "block": 16,
      "emotion": "serious",
      "pace": "slow",
      "pause": 0.4,
      "say": [
        "هاي هي الصيغة اللي بتحسب فيها بالامتحان. وبعد شوي بنتأكد منها بمثال."
      ]
    },
    {
      "block": 17,
      "emotion": "emphatic",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "الأوسط بيجي معكوس. السبب إنه الدور دائري: واي زِد، وبعدين زِد إكس، وبعدين إكس واي. هيك ما بتنسى."
      ]
    },
    {
      "block": 18,
      "frame": 1,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.9,
      "say": [
        "حط الأول بالصف التاني والتاني بالتالت. قبل ما تضغط، توقّع: شو بيطلع؟"
      ]
    },
    {
      "block": 18,
      "frame": 2,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "الأول: ناقص اتنين. التاني: ناقص اتنين كمان. والتالت: واحد."
      ]
    },
    {
      "block": 18,
      "frame": 3,
      "emotion": "excited",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "شوف! الضرب السلمي مع كل واحد منهم صفر. يعني فعلاً عمودي على الاتنين."
      ]
    },
    {
      "block": 18,
      "frame": 4,
      "emotion": "reassuring",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "والطول: تسعة من الجهتين. يعني الطول تلاتة، زي ما التعريف بده. هيك تأكدنا من الصيغة بإيدينا."
      ]
    },
    {
      "block": 19,
      "emotion": "encouraging",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "رتّب الأحرف الأول، وبعدين المركّب الأوسط."
      ]
    },
    {
      "block": 22,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.9,
      "say": [
        "شو بيصير لو بدّلنا الترتيب؟ خمّن."
      ]
    },
    {
      "block": 23,
      "frame": 1,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "عنا الأول ضرب التاني، والإبهام لفوق."
      ]
    },
    {
      "block": 23,
      "frame": 2,
      "emotion": "surprised",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "هلّق بدّلنا… نفس الطول، بس الإبهام نزل لتحت! الإشارة انقلبت."
      ]
    },
    {
      "block": 24,
      "emotion": "calm",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "الأولى هي المهمة: بدّل الترتيب بتقلب الإشارة. والباقي زي الأرقام العادية، بتطلّع العدد برا وبتوزّع الجمع."
      ]
    },
    {
      "block": 28,
      "emotion": "emphatic",
      "pace": "normal",
      "pause": 0.4,
      "say": [
        "أخطر غلطة: تنسى إشارة التبديل، أو تحط كوس مكان ساين."
      ]
    },
    {
      "block": 30,
      "frame": 1,
      "emotion": "curious",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "نرجع لسؤالنا. بالصيغة: الأول صفر، التاني صفر، والتالت ستة."
      ]
    },
    {
      "block": 30,
      "frame": 2,
      "emotion": "excited",
      "pace": "normal",
      "pause": 0.5,
      "say": [
        "لفوق وطوله ستة، بالضبط مساحة المتوازي اتنين ضرب تلاتة!"
      ]
    },
    {
      "block": 30,
      "frame": 2,
      "emotion": "warm",
      "pace": "normal",
      "pause": 0.3,
      "say": [
        "عمودي، مساحة، إيد يمين. بالتوفيق!"
      ]
    }
  ]
}
