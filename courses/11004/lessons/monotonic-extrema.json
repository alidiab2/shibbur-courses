ight=\"800\" text-anchor=\"middle\" direction=\"ltr\">f' −</text><text class=\"fk-t t-good\" x=\"382.5\" y=\"322\" font-size=\"20\" font-weight=\"800\" text-anchor=\"middle\" direction=\"ltr\">f' +</text><text class=\"fk-t t-good\" x=\"97.5\" y=\"370\" font-size=\"22\" font-weight=\"800\" text-anchor=\"middle\" direction=\"ltr\">↗</text><text class=\"fk-t t-bad\" x=\"240.0\" y=\"370\" font-size=\"22\" font-weight=\"800\" text-anchor=\"middle\" direction=\"ltr\">↘</text><text class=\"fk-t t-good\" x=\"382.5\" y=\"370\" font-size=\"22\" font-weight=\"800\" text-anchor=\"middle\" direction=\"ltr\">↗</text></svg>",
