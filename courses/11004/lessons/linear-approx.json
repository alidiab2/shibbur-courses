          "body": "\\(\\tfrac\\pi4+\\tfrac12\\cdot0.1=\\tfrac\\pi4+0.05\\)"
        }
      ],
      "a": "الجواب \\(\\arctan1.1\\approx\\frac\\pi4+0.05\\approx0.835\\)"
    },
