    {
      "t": "xq",
      "q": "سؤال: \\(f(x)=ax+1\\) لـ \\(x&lt;2\\)، و\\(f(x)=x^2-a\\) لـ \\(x\\ge2\\). اوجدوا \\(a\\) بحيث \\(f\\) متصلة",
      "steps": [
        {
          "label": "من الشمال",
          "body": "\\(\\lim_{x\\to2^-}(ax+1)=2a+1\\)"
        },
        {
          "label": "من اليمين وبالنقطة",
          "body": "\\(f(2)=4-a\\)"
        },
        {
          "label": "ساوي وحل",
          "body": "\\(2a+1=4-a\\ \\Rightarrow\\ a=1\\)"
        },
        {
          "label": "فحص",
          "body": "\\(2\\cdot1+1=3=4-1\\)"
        }
      ],
