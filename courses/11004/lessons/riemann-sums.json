    {
      "t": "xq",
      "q": "سؤال: احسبوا \\(\\int_0^2x^2dx\\) كنهاية لمجاميع ريمان (طرف يمين)",
      "steps": [
        {
          "label": "العرض والنقاط",
          "body": "\\(\\Delta x=\\frac2n,\\ x_k=\\frac{2k}{n}\\)"
        },
        {
          "label": "المجموع",
          "body": "\\(S_n=\\sum_{k=1}^n\\frac{4k^2}{n^2}\\cdot\\frac2n=\\frac{8}{n^3}\\sum k^2\\)"
        },
