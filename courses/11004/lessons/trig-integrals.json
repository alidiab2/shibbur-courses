    {
      "t": "xq",
      "q": "سؤال: احسبوا \\(\\int\\sqrt{1-x^2}\\,dx\\)",
      "steps": [
        {
          "label": "تعويض \\(x=\\sin\\theta\\)، \\(-\\frac\\pi2\\le\\theta\\le\\frac\\pi2\\)",
          "body": "\\(dx=\\cos\\theta\\,d\\theta,\\ \\sqrt{1-x^2}=\\cos\\theta\\)"
        },
        {
          "label": "التكامل بيصير",
          "body": "\\(\\int\\cos^2\\theta\\,d\\theta=\\int\\frac{1+\\cos2\\theta}{2}d\\theta\\)"
        },
        {
          "label": "منكامل",
          "body": "\\(\\frac\\theta2+\\frac{\\sin2\\theta}{4}=\\frac\\theta2+\\frac{\\sin\\theta\\cos\\theta}{2}\\)"
        },
        {
          "label": "رجوع لـ \\(x\\) من المثلث",
          "body": "\\(\\frac{\\arcsin x+x\\sqrt{1-x^2}}{2}+C\\)"
        }
      ],
      "a": "الجواب \\(\\frac12\\left(\\arcsin x+x\\sqrt{1-x^2}\\right)+C\\)"
    },
