      "q": "سؤال: اوجدوا ميل المماس للمنحنى \\(x^3+y^3=6xy\\) بالنقطة \\((3,3)\\)",
      "steps": [
        {
          "label": "النقطة على المنحنى",
          "body": "\\(27+27=6\\cdot 9\\)"
        },
        {
          "label": "اشتق الجهتين",
          "body": "\\(3x^2+3y^2y'=6y+6xy'\\)"
        },
        {
          "label": "اعزل \\(y'\\)",
          "body": "\\(y'=\\frac{2y-x^2}{y^2-2x}\\)"
        },
        {
          "label": "عوّض",
          "body": "\\(y'=\\frac{6-9}{9-6}=-1\\)"
        }
      ],
