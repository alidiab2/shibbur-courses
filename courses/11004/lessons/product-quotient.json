            "html": "\\(\\dfrac{1}{\\cos^2x}\\)"
          },
          {
            "v": "2",
            "html": "\\(-\\dfrac{1}{\\sin^2x}\\)"
          },
          {
            "v": "3",
            "html": "\\(\\dfrac{1}{\\sin^2x}\\)"
          }
        ],
        "answer": [
          "1"
        ],
        "hint": "\\(\\tan x=\\frac{\\sin x}{\\cos x}\\) وقاعدة القسمة.",
        "solution": "<div class=\"disp-wrap\"><div class=\"disp\">\\[\\left(\\frac{\\sin x}{\\cos x}\\right)'=\\frac{\\cos^2x+\\sin^2x}{\\cos^2x}=\\frac{1}{\\cos^2x}\\]</div></div>"
      }
