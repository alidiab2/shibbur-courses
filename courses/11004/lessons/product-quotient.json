        ],
        "hint": "قاعدة الضرب.",
        "solution": "<div class=\"disp-wrap\"><div class=\"disp\">\\[f'(x)=e^x+xe^x,\\quad f'(0)=1+0=1\\]</div></div>"
      }
    },
    {
      "t": "quiz",
      "q": {
        "kind": "text",
        "prompt": "\\(f(x)=\\dfrac{\\ln x}{x}\\). قديش \\(f'(1)\\)؟",
        "answer": [
          "1"
        ],
        "hint": "قاعدة القسمة: \\(\\frac{\\frac1x\\cdot x-\\ln x}{x^2}\\).",
        "solution": "<div class=\"disp-wrap\"><div class=\"disp\">\\[f'(x)=\\frac{1-\\ln x}{x^2},\\quad f'(1)=\\frac{1-0}{1}=1\\]</div></div>"
      }
    },
    {
      "t": "quiz",
      "q": {
        "kind": "mc",
        "prompt": "شو \\((\\tan x)'\\)؟",
        "options": [
          {
