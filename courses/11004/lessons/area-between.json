    {
      "t": "quiz",
      "q": {
        "kind": "text",
        "prompt": "شو المساحة تحت \\(y=\\sin x\\) من 0 لـ \\(\\pi\\)؟",
        "answer": [
          "2"
        ],
        "hint": "متل الدرس اللي فات.",
        "solution": "<p>الدالة موجبة على \\([0,\\pi]\\)، فالمساحة هي التكامل: \\(\\big[-\\cos x\\big]_0^\\pi=1+1=2\\).</p>"
      }
    },
    {
      "t": "quiz",
      "q": {
        "kind": "text",
        "prompt": "شو المساحة بين \\(y=x^2\\) و\\(y=2x\\)؟",
        "answer": [
          "4/3",
          "1.33"
        ],
        "hint": "تقاطع بـ 0 و2، و\\(2x\\) فوق.",
        "solution": "<div class=\"disp-wrap\"><div class=\"disp\">\\[\\int_0^2(2x-x^2)dx=\\Big[x^2-\\tfrac{x^3}{3}\\Big]_0^2=4-\\tfrac83=\\tfrac43\\]</div></div>"
      }
    },
    {
      "t": "quiz",
      "q": {
        "kind": "text",
        "prompt": "شو المساحة بين \\(y=x^3\\) ومحور الـ \\(x\\) من \\(-1\\) لـ 1؟",
        "answer": [
          "1/2",
          "0.5"
        ],
        "hint": "قسّموا بـ 0.",
        "solution": "<div class=\"disp-wrap\"><div class=\"disp\">\\[\\int_{-1}^0(-x^3)dx+\\int_0^1x^3dx=\\tfrac14+\\tfrac14=\\tfrac12\\]</div></div>"
      }
